{
  "appId": "com.sellora.desktop",
  "productName": "Sellora",
  "directories": {
    "output": "release"
  },
  "files": [
    "desktop/main.mjs",
    "desktop/policy.mjs",
    "package.json",
    "!node_modules/**"
  ],
  "extraMetadata": {
    "main": "desktop/main.mjs"
  },
  "extraResources": [
    {
      "from": ".desktop-web",
      "to": "web",
      "filter": [
        "**/*",
        "!**/.env*",
        "!**/*.map"
      ]
    },
    {
      "from": ".desktop-web/node_modules",
      "to": "web/node_modules",
      "filter": [
        "**/*"
      ]
    }
  ],
  "win": {
    "target": "portable",
    "artifactName": "Sellora-${version}-Windows-x64.exe",
    "signAndEditExecutable": false
  },
  "portable": {
    "requestExecutionLevel": "user"
  },
  "npmRebuild": false
}
