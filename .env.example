# Configure apenas quando integrar Supabase. Nunca commite segredos reais.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca use a service_role no app.
# Prospecção IA (aba em /leads). Desligada se vazia. "osm" = OpenStreetMap (Nominatim + Overpass) + verificação HTTP:
# gratuito, sem chave, sem cobrança. Reinicie o servidor depois de alterar.
PROSPECCAO_EXECUTOR=
# Opcional: instâncias alternativas (padrão: servidores públicos do OpenStreetMap).
# PROSPECCAO_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# PROSPECCAO_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Opcional: usuários de TESTE para scripts/rls-check.mjs (node --env-file=.env.local scripts/rls-check.mjs)
# RLS_TEST_A_EMAIL=
# RLS_TEST_A_PASSWORD=
# RLS_TEST_B_EMAIL=
# RLS_TEST_B_PASSWORD=
# Imagens das demos: Codex da conta ChatGPT deste computador (sem chave nem API paga);
# sem Codex com geração de imagens, a demo usa composições gráficas gratuitas.
# Opcional: textos com outro modelo Claude (padrão claude-sonnet-5-5) ou executável específico do Claude Code.
# SELLORA_CLAUDE_MODEL=
# SELLORA_CLAUDE_PATH=
# Opcional: conta Claude separada só para o gerador de demos (pasta absoluta própria; nunca a ~/.claude da conta principal).
# Faça o login uma vez nela: $env:CLAUDE_CONFIG_DIR="<pasta>"; claude auth login --claudeai (só naquela janela do terminal).
# SELLORA_DEMO_CLAUDE_CONFIG_DIR=
# Imagens geradas pelo Codex por demo (1 a 3; padrão 3). O briefing usa menos quando o design não pede mais.
SELLORA_DEMO_MAX_IMAGES=3
# Opcional: rodadas da revisão de impacto visual com capturas reais (0 a 3; padrão 2; 0 desliga).
# SELLORA_DEMO_VISUAL_REVIEW_ROUNDS=2
# Opcional: publicação das demos no Coolify (ver docs/COOLIFY_INTEGRATION.md). Sem estas variáveis, publicar fica desligado.
# COOLIFY_API_URL=
# COOLIFY_API_TOKEN=
# COOLIFY_PROJECT_UUID=
# COOLIFY_SERVER_UUID=
# COOLIFY_ENVIRONMENT_NAME=production
# COOLIFY_DESTINATION_UUID=
# COOLIFY_GITHUB_APP_UUID=
# SELLORA_DEMOS_GITHUB_REPO=
# SELLORA_DEMOS_GITHUB_TOKEN=
# SELLORA_DEMOS_GITHUB_BRANCH=main
# SELLORA_DEMOS_GITHUB_PATH=demos
# SELLORA_DEMOS_BASE_DOMAIN=
# Opcional: Cloud 3D (escritório Claw3D local, ver docs/CLAW3D_INTEGRATION.md). Só 127.0.0.1/localhost.
# SELLORA_CLAW3D_URL=http://127.0.0.1:3190
