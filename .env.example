# Configure apenas quando integrar Supabase. Nunca commite segredos reais.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca use a service_role no app.
# Prospecção IA (aba em /leads). Desligada se vazia. "osm" = OpenStreetMap (Nominatim + Overpass) + verificação HTTP:
# gratuito, sem chave, sem cobrança. Reinicie o servidor depois de alterar.
PROSPECCAO_EXECUTOR=
# Opcional: instâncias alternativas (padrão: servidores públicos do OpenStreetMap).
# PROSPECCAO_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# PROSPECCAO_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Opcional: usuários de TESTE para scripts/rls-check.mjs (node --env-file=.env.local scripts/rls-check.mjs)
# RLS_TEST_A_EMAIL=
# RLS_TEST_A_PASSWORD=
# RLS_TEST_B_EMAIL=
# RLS_TEST_B_PASSWORD=
# Imagens das demos (Gemini, Nano Banana 2.1). Pago por imagem, sem plano gratuito. Só no servidor.
# No aplicativo Windows, defina como variável de ambiente do usuário e reabra o Sellora.
GEMINI_API_KEY=
# Opcional: outro modelo de imagem (padrão gemini-nano-banana-2.1).
# SELLORA_GEMINI_IMAGE_MODEL=
# Opcional: textos com outro modelo Claude (padrão claude-sonnet-5-5) ou executável específico do Claude Code.
# SELLORA_CLAUDE_MODEL=
# SELLORA_CLAUDE_PATH=
